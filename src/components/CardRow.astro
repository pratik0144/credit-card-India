<script>
  // Accordion toggles
  document.querySelectorAll<HTMLButtonElement>('[data-nw-accordion]').forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
    const icon = btn.querySelector('.nw-card__accordion-icon');
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      if (panel) panel.hidden = open;
    });
  });



  // Compare checkbox → navigate to compare page
  document.querySelectorAll<HTMLInputElement>('[data-compare-card]').forEach((cb) => {
    cb.addEventListener('change', () => {
      if (cb.checked) {
        const slug = cb.dataset.compareCard;
        if (slug) window.location.href = `/compare?add=${slug}`;
      }
    });
  });
</script>
